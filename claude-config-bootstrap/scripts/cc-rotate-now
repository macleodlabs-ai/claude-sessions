#!/usr/bin/env bash
#
# cc-rotate-now — manually rotate a cc-rotate pool session to another account.
#
# Same mechanism as the rate-limit hook (cc-rotate-kill): write the rotate flag
# and TERM the claude process; the supervisor then relaunches on another account
# with `--resume`. The flag's content marks the rotation as manual (so the
# supervisor neither counts it as a rate limit nor auto-submits a turn) and may
# name the target account.
#
# Usage:
#   cc-rotate-now [MEMBER]                  # from inside a pooled session (/rotate, or `! cc-rotate-now`)
#   cc-rotate-now --client CLIENT [MEMBER]  # from any terminal: rotate CLIENT's running pool session
#
# MEMBER is a pool account label (e.g. macleod-2); omitted = the next account
# in pool order, wrapping around to the first.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SHARED_DIR="${SHARED_DIR:-$SCRIPT_DIR}"
RUN_DIR="${SHARED_DIR}/pools/run"
fail() { printf 'cc-rotate-now: %s\n' "$1" >&2; exit 1; }

CLIENT=""; TARGET=""
while [ $# -gt 0 ]; do
  case "$1" in
    --client) CLIENT="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) TARGET="$1"; shift ;;
  esac
done

pidfile=""
if [ -n "$CLIENT" ]; then
  # Each live supervisor registers "$RUN_DIR/<client>.<supervisor-pid>" holding its pid file path.
  live=()
  for r in "$RUN_DIR/$CLIENT".*; do
    [ -f "$r" ] || continue
    if kill -0 "${r##*.}" 2>/dev/null; then live+=("$r"); else rm -f "$r"; fi
  done
  [ "${#live[@]}" -gt 0 ] || fail "no running pool session for '$CLIENT' (start one with cc-$CLIENT)"
  if [ "${#live[@]}" -gt 1 ]; then
    printf 'cc-rotate-now: %s pool sessions for %s are running; rotate one from inside it with /rotate.\n' "${#live[@]}" "$CLIENT" >&2
    exit 1
  fi
  pidfile="$(cat "${live[0]}")"
else
  [ "${CC_ROTATE_ACTIVE:-0}" = "1" ] && [ -n "${CC_ROTATE_PIDFILE:-}" ] \
    || fail "this session wasn't started by a pooled cc-<client> launcher (cc-<client>-N sessions never rotate). From another terminal: cc-rotate-now --client <client>"
  pidfile="$CC_ROTATE_PIDFILE"
fi

[ -f "$pidfile" ] || fail "supervisor pid file is gone ($pidfile) — is the session still running?"
pid="$(cat "$pidfile" 2>/dev/null || true)"
case "$pid" in ''|*[!0-9]*) fail "no claude pid in $pidfile" ;; esac

printf 'manual:%s\n' "$TARGET" > "${pidfile}.rotate"
printf 'cc-rotate-now: rotating%s — the session resumes on the new account in a moment.\n' "${TARGET:+ to $TARGET}" >&2
kill -TERM "$pid" 2>/dev/null || fail "could not signal claude (pid $pid)"
