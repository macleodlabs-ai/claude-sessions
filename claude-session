#!/usr/bin/env bash
#
# claude-session — manage isolated, per-client Claude Code accounts on one machine.
#
# Owns the shell integration (the cc-<client> launchers, the bare-claude guard,
# and a global, auto-sourcing `claude-session` command) and delegates per-client
# memory + statusline config to claude-config-bootstrap's setup.sh.
#
# Usage:
#   claude-session --create macleod clientA   # add one or more clients
#   claude-session --delete clientA           # remove one or more clients
#   claude-session --list                     # list configured clients
#   claude-session --pool-add macleod         # add a rotation account to a client
#   claude-session --pool-list macleod        # show a client's rotation pool
#   claude-session --pool-remove macleod-2    # remove a rotation account
#   claude-session --login macleod-2          # (re)log in an account by name
#   claude-session --usage macleod            # 5h/7d usage of every account in the pool
#   claude-session --pin macleod-2 me@work.com   # macleod-2 must stay logged in as me@work.com
#   claude-session --rotate macleod [macleod-2]  # switch a running pool session's account now
#   /rotate [macleod-2]                       # same, typed inside the pooled session
#   cc-macleod-2                              # run pool account #2 directly (logs in first if needed)
#   claude-session --update                   # pull the latest version and refresh every client
#   claude-session --revert                   # remove all tooling (keep accounts)
#   claude-session --revert --force           # also delete every client account dir
#
# Flags:
#   --create NAME...     Bootstrap each client (config dir, memory, statusline, launcher).
#                        Launchers default to --permission-mode auto; an explicit
#                        --permission-mode or --dangerously-skip-permissions wins.
#   --delete NAME...     Remove each client's config dir and launcher.
#   --list               Show configured clients.
#   --pool-add CLIENT    Add the next rotation account (<client>-2, -3, ...) to CLIENT's
#                        pool and walk you through logging it in. cc-<client> then
#                        auto-rotates to the next account on a rate limit, resuming
#                        the same conversation. Each member also gets its own
#                        launcher named like its footer label (cc-<client>-N):
#                        it logs the account in if needed, then starts a
#                        non-rotating session on that account.
#   --pool-list CLIENT   Show CLIENT's pool members, order, and login state.
#   --usage CLIENT       Show each pool account's login, last-seen 5h/7d usage and
#                        reset times (recorded by the statusline of that account's
#                        sessions), and flag members logged into the same account.
#   --pin NAME EMAIL     Pin the account NAME (client or pool member) must be logged
#                        into. Logins pre-fill it and are verified against it; once
#                        the dir is on that account its logins are locked to the
#                        account's org (forceLoginOrgUUID in its settings.json);
#                        cc-rotate skips and cc-<client>-N refuses a dir logged
#                        into anything else; the footer flags it. --pin NAME --clear
#                        removes it. (A /login inside a rotated session saves to the
#                        account active at that moment — this is what catches it.)
#   --rotate CLIENT [MEMBER]
#                        Manually rotate CLIENT's running cc-<client> session to
#                        MEMBER (default: the next account, wrapping around),
#                        resuming the same conversation. Inside the session, use
#                        /rotate [MEMBER] instead.
#   --pool-remove NAME   Remove pool member NAME (e.g. macleod-2) and delete its dir.
#                        Removing the last member disbands the pool (single-account
#                        behavior and private history are restored).
#   --login NAME...      Run claude's login flow in NAME's config dir — no
#                        CLAUDE_CONFIG_DIR to remember. NAME is any client or pool
#                        member; a pooled client name logs in every member that
#                        still has no credentials.
#   --update             Fast-forward claude-session's own clone (~/.claude-shared/src,
#                        never your dev checkout) and refresh every client from it:
#                        skill copy, memory, statusline, helper scripts, launchers.
#                        This also runs on its own: every cc- launch and every running
#                        session's statusline start `--update --auto` in the
#                        background at most hourly (a no-op unless the repo moved).
#                        Statusline and hooks are re-read on each use, so updates
#                        reach running sessions; CCB_NO_AUTOUPDATE=1 turns it off.
#   --revert             Remove rc launchers, the global command, and ~/.claude-shared.
#                        Client account dirs are kept; pooled session history is
#                        restored to each client's primary dir first.
#   --yes, -y            Skip confirmation prompts.
#   --force              With --revert, also delete every client account dir,
#                        including pool members (implies --yes).
#   -h, --help           Show this help.

set -euo pipefail

# --- styling ---------------------------------------------------------------
if [ -t 1 ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
  GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; BLUE=$'\033[34m'
else BOLD=""; DIM=""; RESET=""; GREEN=""; YELLOW=""; RED=""; BLUE=""; fi
ok()   { printf "  ${GREEN}✓${RESET} %s\n" "$1"; }
add()  { printf "  ${BLUE}+${RESET} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${RESET} %s\n" "$1"; }
err()  { printf "  ${RED}✗${RESET} %s\n" "$1" >&2; }
info() { printf "  ${DIM}%s${RESET}\n" "$1"; }
hdr()  { printf "\n${BOLD}%s${RESET}\n" "$1"; }
die()  { err "$1"; exit "${2:-1}"; }

# --- paths & config --------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SHARED_DIR="${SHARED_DIR:-$HOME/.claude-shared}"
CLIENTS_PARENT="${CLIENTS_PARENT:-$HOME/.claude-clients}"
SKILLS_DIR="${SKILLS_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills}"
CLI_INSTALL_PATH="${SHARED_DIR}/claude-session"
DEST_SKILL="${SKILLS_DIR}/claude-config-bootstrap"
POOLS_DIR="${SHARED_DIR}/pools"
POOL_MARKER=".ccb-pool-member"   # present in a dir => rotation member, not a client
UPDATE_SRC="${SHARED_DIR}/src"              # --update's own clone (never your dev checkout)
SOURCE_FILE="${SHARED_DIR}/.ccb-source"     # git URL --update pulls from
UPDATE_STAMP="${SHARED_DIR}/.update-stamp"  # last update check; auto-update runs at most hourly
UPDATE_LOG="${SHARED_DIR}/update.log"

SENTINEL_BEGIN="<!-- claude-config-bootstrap:begin -->"   # marks a bootstrapped CLAUDE.md
RC_BEGIN="# >>> claude-config-bootstrap launchers >>>"
RC_END="# <<< claude-config-bootstrap launchers <<<"

# --- rc file ---------------------------------------------------------------
RC_FILE="${RC_FILE:-}"
if [ -z "$RC_FILE" ]; then
  case "${SHELL:-}" in
    *bash) RC_FILE="$HOME/.bashrc" ;;
    *)     RC_FILE="$HOME/.zshrc" ;;
  esac
fi

# --- arg parsing -----------------------------------------------------------
MODE=""; FORCE=0; ASSUME_YES=0; AUTO=0; PIN_EMAIL=""; declare -a NAMES=()
print_help() { awk 'NR>1 && /^set -euo/{exit} NR>1' "$0" | sed 's/^# \{0,1\}//'; }
sanitize() { printf '%s' "$1" | tr -cd '[:alnum:]_-'; }

while [ $# -gt 0 ]; do
  case "$1" in
    --create) MODE="create"; shift ;;
    --delete) MODE="delete"; shift ;;
    --list)   MODE="list"; shift ;;
    --pool-add)    MODE="pool-add"; shift ;;
    --pool-list)   MODE="pool-list"; shift ;;
    --pool-remove) MODE="pool-remove"; shift ;;
    --login)       MODE="login"; shift ;;
    --usage)       MODE="usage"; shift ;;
    --rotate)      MODE="rotate"; shift ;;
    --pin)         MODE="pin"; shift
                   [ $# -ge 2 ] && { NAMES+=("$(sanitize "$1")"); PIN_EMAIL="$2"; shift 2; } ;;
    --revert) MODE="revert"; shift ;;
    --update) MODE="update"; shift ;;
    --auto)   AUTO=1; shift ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    --force)  FORCE=1; ASSUME_YES=1; shift ;;
    -h|--help) print_help; exit 0 ;;
    --*) die "Unknown flag: $1 (try --help)" 2 ;;
    *) NAMES+=("$(sanitize "$1")"); shift ;;
  esac
done
[ -n "$MODE" ] || { print_help; exit 0; }

# --- helpers ---------------------------------------------------------------
confirm() {  # $1 = prompt; returns 0 to proceed
  [ "$ASSUME_YES" -eq 1 ] && return 0
  printf "  ${YELLOW}?${RESET} %s [y/N] " "$1"
  local r; read -r r </dev/tty || r=""
  case "$r" in [yY]|[yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

fn_label() { local b; b="$(basename "$1")"; b="${b#.claude-}"; printf 'cc-%s' "$(sanitize "$b")"; }

discover_dirs() {  # populates global CC_DIRS with bootstrapped client dirs
  CC_DIRS=()
  [ -d "$CLIENTS_PARENT" ] || return 0
  local d
  for d in "$CLIENTS_PARENT"/*/; do
    d="${d%/}"; [ -d "$d" ] || continue
    [ -f "$d/$POOL_MARKER" ] && continue   # rotation members aren't standalone clients
    [ -f "$d/CLAUDE.md" ] && grep -qF "$SENTINEL_BEGIN" "$d/CLAUDE.md" 2>/dev/null && CC_DIRS+=("$d")
  done
}

discover_members() {  # populates global CC_MEMBERS with pool member dirs (primaries excluded)
  CC_MEMBERS=()
  local pf d first
  for pf in "$POOLS_DIR"/*.pool; do
    [ -f "$pf" ] || continue
    first=1
    while IFS= read -r d; do
      case "$d" in ''|\#*) continue ;; esac
      [ "$first" -eq 1 ] && { first=0; continue; }   # line 1 is the primary
      [ -f "$d/$POOL_MARKER" ] && CC_MEMBERS+=("$d")
    done < "$pf"
  done
  return 0
}

build_block() {  # prints the rc block for the current CC_DIRS + CC_MEMBERS
  printf '%s\n' "$RC_BEGIN"
  printf '# Managed by claude-session. Do not edit between these markers;\n'
  printf '# run `claude-session --create/--delete` to refresh, `--revert` to remove.\n'
  # Each launcher checks for a rotation pool at runtime: with a pool file the
  # cc-rotate supervisor takes over (rotate accounts on rate limit); without
  # one it launches claude directly. Either way the session runs in auto
  # permission mode unless the caller passed a mode of their own
  # (`--permission-mode X` or `--dangerously-skip-permissions`).
  # A dir logged in with a subscription must use it: an ANTHROPIC_API_KEY in the
  # environment would otherwise win once approved, billing an API account (and
  # failing "Credit balance is too low" when it's empty). cc-rotate and
  # cc-member apply the same rule. Each dir also sticks to the account it was
  # first logged into (cc-account-guard pins it, and refuses a drifted dir).
  printf '_ccb_guard=%q\n' "$SHARED_DIR/cc-account-guard"
  # Auto-update: every launch starts a background `--update --auto` at most once
  # an hour (the statusline does the same inside running sessions). It does
  # nothing unless the repo has new commits. CCB_NO_AUTOUPDATE=1 turns it off.
  printf '_ccb_cli=%q _ccb_src=%q _ccb_stamp=%q _ccb_log=%q\n' "$CLI_INSTALL_PATH" "$SOURCE_FILE" "$UPDATE_STAMP" "$UPDATE_LOG"
  cat <<'UPDATER'
_ccb_autoupdate() {
  [ -z "${CCB_NO_AUTOUPDATE:-}" ] && [ -f "$_ccb_src" ] || return 0
  [ -n "$(find "$_ccb_stamp" -mmin -60 2>/dev/null)" ] && return 0
  : > "$_ccb_stamp" 2>/dev/null
  ( "$_ccb_cli" --update --auto </dev/null >>"$_ccb_log" 2>&1 & ) 2>/dev/null
  return 0
}
UPDATER
  cat <<'RUNNER'
_ccb_claude() {
  local d="$1"; shift
  if [ -x "$_ccb_guard" ] && ! "$_ccb_guard" "$d"; then
    printf 'Not launching %s on the wrong account.\n' "${d##*/}" >&2; return 1
  fi
  if grep -qE '"oauthAccount": *\{' "$d/.claude.json" 2>/dev/null; then
    ( unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN; CLAUDE_CONFIG_DIR="$d" command claude "$@" )
  else
    CLAUDE_CONFIG_DIR="$d" command claude "$@"
  fi
}
RUNNER
  local d
  for d in "${CC_DIRS[@]}"; do
    printf '%s() { _ccb_autoupdate; if [ -f %q ]; then %q %q "$@"; else case " $* " in *" --permission-mode"*|*" --dangerously-skip-permissions"*) _ccb_claude %q "$@" ;; *) _ccb_claude %q --permission-mode auto "$@" ;; esac; fi; }\n' \
      "$(fn_label "$d")" "$POOLS_DIR/$(basename "$d").pool" "$SHARED_DIR/cc-rotate" "$(basename "$d")" "$d" "$d"
  done
  # Pool members get a direct, non-rotating launcher named like their footer
  # label (cc-<client>-N). cc-member logs the account in first if needed.
  for d in ${CC_MEMBERS[@]+"${CC_MEMBERS[@]}"}; do
    printf '%s() { _ccb_autoupdate; %q %q "$@"; }\n' "$(fn_label "$d")" "$SHARED_DIR/cc-member" "$d"
  done
  # Global, auto-sourcing wrapper: runs the installed CLI then reloads this shell
  # so freshly-added cc-<client> launchers are usable immediately.
  printf 'claude-session() { CLAUDE_SESSION_WRAPPED=1 %q "$@"; local _rc=$?; source %q; return $_rc; }\n' \
    "$CLI_INSTALL_PATH" "$RC_FILE"
  cat <<'NEUTER'
claude() {
  printf 'Refusing to launch an unlabeled claude (would use the DEFAULT ~/.claude account).\n' >&2
  printf 'Use one of the per-client launchers instead:\n' >&2
  typeset -f 2>/dev/null | grep -oE '^cc-[A-Za-z0-9_-]+' | sort -u | sed 's/^/  /' >&2 || true
  printf 'Or run: command claude   (to bypass this guard on purpose)\n' >&2
  return 1
}
NEUTER
  printf '%s\n' "$RC_END"
}

apply_block() {  # $1 = block text, or "" to remove the block entirely
  local newblock="$1" tmp had=0
  mkdir -p "$(dirname "$RC_FILE")"; [ -f "$RC_FILE" ] || : > "$RC_FILE"
  grep -qF "$RC_BEGIN" "$RC_FILE" && had=1
  cp "$RC_FILE" "${RC_FILE}.ccbak" 2>/dev/null || true
  tmp="$(mktemp)"
  # Strip any existing block (awk without -v body interpolation keeps backslashes intact).
  awk -v b="$RC_BEGIN" -v e="$RC_END" '
    $0==b {skip=1; next} $0==e {skip=0; next} skip==0 {print}
  ' "$RC_FILE" > "$tmp"
  if [ -n "$newblock" ]; then
    printf '%s\n\n%s\n' "$(cat "$tmp")" "$newblock" > "$RC_FILE"
  else
    printf '%s\n' "$(cat "$tmp")" > "$RC_FILE"
  fi
  rm -f "$tmp"
  return "$had"  # 1 if a block already existed (informational)
}

rebuild_launchers() {
  discover_dirs
  discover_members
  if [ "${#CC_DIRS[@]}" -eq 0 ]; then
    apply_block "" || true
    add "No clients left — removed launcher block (bare 'claude' restored)"
  else
    apply_block "$(build_block)" || true
    local d names=""
    for d in "${CC_DIRS[@]}" ${CC_MEMBERS[@]+"${CC_MEMBERS[@]}"}; do names="${names} $(fn_label "$d")"; done
    ok "Launchers refreshed:${names}"
    # Member launchers call cc-member; make sure an upgraded install has it.
    if [ "${#CC_MEMBERS[@]}" -gt 0 ] && [ ! -x "$SHARED_DIR/cc-member" ]; then install_rotate; fi
    install_rotate_cmds
  fi
}

find_setup() {
  local c
  for c in "$SCRIPT_DIR/claude-config-bootstrap/scripts/setup.sh" "$DEST_SKILL/scripts/setup.sh"; do
    [ -f "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

install_skill() {  # copy the skill into the skills dir so Claude can trigger it
  local src=""
  if [ -d "$SCRIPT_DIR/claude-config-bootstrap" ]; then src="$SCRIPT_DIR/claude-config-bootstrap"
  elif [ -d "$DEST_SKILL" ]; then src="$DEST_SKILL"; fi
  [ -n "$src" ] || die "skill source not found (run from the repo, or reinstall)"
  if [ ! "$src" -ef "$DEST_SKILL" ]; then
    mkdir -p "$SKILLS_DIR"; rm -rf "$DEST_SKILL"; cp -R "$src" "$DEST_SKILL"
    ok "Installed skill → $DEST_SKILL"
  else
    ok "Skill already installed → $DEST_SKILL"
  fi
  chmod +x "$DEST_SKILL/scripts/setup.sh" 2>/dev/null || true
}

install_cli() {  # make `claude-session` globally available
  mkdir -p "$SHARED_DIR"
  if [ ! "$0" -ef "$CLI_INSTALL_PATH" ]; then
    # Copy then rename: --update re-runs from its clone while the installed
    # copy (a bash script, read incrementally) is still executing.
    cp "$0" "$CLI_INSTALL_PATH.new" && chmod +x "$CLI_INSTALL_PATH.new" && mv -f "$CLI_INSTALL_PATH.new" "$CLI_INSTALL_PATH"
    ok "Installed command → $CLI_INSTALL_PATH"
  fi
  # Remember where updates come from: the origin of the checkout we run from.
  local url; url="$(git -C "$SCRIPT_DIR" remote get-url origin 2>/dev/null || true)"
  [ -n "$url" ] && [ ! -f "$SOURCE_FILE" ] && printf '%s\n' "$url" > "$SOURCE_FILE"
  return 0
}

install_skill_into() {  # $1 = a client's config dir: give it the skill unless the plugin does
  local SKILLS_DIR="$1/skills" DEST_SKILL="$1/skills/claude-config-bootstrap"
  if plugin_enabled "$1"; then
    # The plugin ships the skill (and shows in /plugin, where it updates); a
    # copied one would load beside it as a near-identical second skill.
    if [ -f "$DEST_SKILL/SKILL.md" ] && grep -q '^name: claude-config-bootstrap$' "$DEST_SKILL/SKILL.md"; then
      rm -rf "$DEST_SKILL"; add "Removed the copied skill from ${1##*/} (the $PLUGIN_ID plugin provides it)"
    fi
    return 0
  fi
  install_skill
}

# The `sessions` plugin (this repo's own marketplace) makes claude-sessions show
# in /plugin, where it updates; its SessionStart hook runs `--update --auto`.
PLUGIN_ID="sessions@claude-sessions"
PLUGIN_MARKET="macleodlabs-ai/claude-sessions"
plugin_enabled() {  # $1 = config dir
  grep -qE "\"$PLUGIN_ID\": *true" "$1/settings.json" 2>/dev/null
}
ensure_plugin() {  # $1 = config dir: install + enable the plugin there, with auto-update on
  local d="$1" s="$1/settings.json" tmp
  [ "${CCB_NO_PLUGIN:-}" = "1" ] && return 0
  if ! plugin_enabled "$d"; then
    command -v claude >/dev/null 2>&1 || { warn "claude not on PATH — skipped installing the $PLUGIN_ID plugin in ${d##*/}"; return 0; }
    # Plugins are per config dir. HTTPS: the repo is public, and SSH may have no key.
    CLAUDE_CONFIG_DIR="$d" CLAUDE_CODE_PLUGIN_PREFER_HTTPS=1 command claude plugin marketplace add "$PLUGIN_MARKET" --scope user >/dev/null 2>&1 || true
    if CLAUDE_CONFIG_DIR="$d" CLAUDE_CODE_PLUGIN_PREFER_HTTPS=1 command claude plugin install "$PLUGIN_ID" --scope user >/dev/null 2>&1 && plugin_enabled "$d"; then
      add "Installed the $PLUGIN_ID plugin in ${d##*/}"
    else
      warn "could not install the $PLUGIN_ID plugin in ${d##*/} — retry: CLAUDE_CONFIG_DIR=$d claude plugin install $PLUGIN_ID"
      return 0
    fi
  fi
  # Third-party marketplaces don't auto-update by default; this one should.
  command -v jq >/dev/null 2>&1 || return 0
  jq -e '.extraKnownMarketplaces["claude-sessions"].autoUpdate == true' "$s" >/dev/null 2>&1 && return 0
  jq -e '.extraKnownMarketplaces["claude-sessions"]' "$s" >/dev/null 2>&1 || return 0
  tmp="$(mktemp)"
  if jq '.extraKnownMarketplaces["claude-sessions"].autoUpdate = true' "$s" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    cp "$s" "$s.ccbak"; cat "$tmp" > "$s"; add "Turned on auto-update for the claude-sessions marketplace in ${d##*/}"
  fi
  rm -f "$tmp"
}

# --- rotation pools ----------------------------------------------------------
pool_file() { printf '%s/%s.pool' "$POOLS_DIR" "$1"; }
pool_projects() { printf '%s/%s-projects' "$POOLS_DIR" "$1"; }

install_rotate() {  # copy the supervisor, hook helpers, and member launcher next to the CLI
  local src_dir="" c f
  for c in "$SCRIPT_DIR/claude-config-bootstrap/scripts" "$DEST_SKILL/scripts"; do
    [ -f "$c/cc-rotate" ] && { src_dir="$c"; break; }
  done
  [ -n "$src_dir" ] || die "cc-rotate scripts not found (run from the repo, or reinstall)"
  mkdir -p "$SHARED_DIR"
  for f in cc-rotate cc-rotate-kill cc-rotate-now cc-pool-sync cc-member cc-account-guard; do
    if [ -f "$SHARED_DIR/$f" ] && cmp -s "$src_dir/$f" "$SHARED_DIR/$f"; then
      ok "$f already installed → $SHARED_DIR/$f"
    else
      # Copy then rename: a live cc-rotate supervisor is a bash script read
      # incrementally, so overwriting it in place would corrupt running pools.
      cp "$src_dir/$f" "$SHARED_DIR/.$f.new" && chmod +x "$SHARED_DIR/.$f.new" \
        && mv -f "$SHARED_DIR/.$f.new" "$SHARED_DIR/$f"
      add "Installed $f → $SHARED_DIR/$f"
    fi
  done
}

install_rotate_cmds() {  # give every pooled primary a /rotate slash command (commands/ is shared across the pool)
  local pf client f tmp
  for pf in "$POOLS_DIR"/*.pool; do
    [ -f "$pf" ] || continue
    client="$(basename "$pf" .pool)"
    [ -d "$CLIENTS_PARENT/$client" ] || continue
    f="$CLIENTS_PARENT/$client/commands/rotate.md"; tmp="$(mktemp)"
    cat > "$tmp" <<EOF
---
description: Switch this pooled session to another account now, resuming the conversation (optional arg — the account, e.g. $client-2)
argument-hint: [account]
allowed-tools: Bash($SHARED_DIR/cc-rotate-now:*)
disable-model-invocation: true
---
!\`$SHARED_DIR/cc-rotate-now \$ARGUMENTS\`
EOF
    if cmp -s "$tmp" "$f"; then rm -f "$tmp"
    else mkdir -p "$(dirname "$f")"; mv "$tmp" "$f"; add "Installed /rotate for pool '$client'"; fi
  done
}

wire_hook() {  # $1 = config dir: add the StopFailure rate-limit hook to settings.json
  local dir="$1" settings="$1/settings.json" kill_cmd="$SHARED_DIR/cc-rotate-kill"
  local snippet='"hooks": { "StopFailure": [
    { "matcher": "rate_limit",    "hooks": [ { "type": "command", "command": "'"$kill_cmd"'" } ] },
    { "matcher": "billing_error", "hooks": [ { "type": "command", "command": "'"$kill_cmd"'" } ] }
  ] }'
  if [ -f "$settings" ] && grep -qF "cc-rotate-kill" "$settings"; then
    ok "Rate-limit hook already wired in ${dir##*/}/settings.json"
    return 0
  fi
  if [ ! -f "$settings" ]; then
    mkdir -p "$dir"
    printf '{\n  %s\n}\n' "$snippet" > "$settings"
    add "Created settings.json with rate-limit hook in ${dir##*/}"
  elif command -v jq >/dev/null 2>&1; then
    local tmp; tmp="$(mktemp)"
    if jq --arg cmd "$kill_cmd" '.hooks.StopFailure = ((.hooks.StopFailure // []) + [
          {matcher: "rate_limit",    hooks: [{type: "command", command: $cmd}]},
          {matcher: "billing_error", hooks: [{type: "command", command: $cmd}]}
        ])' "$settings" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$settings"
      add "Added rate-limit hook to existing settings.json (other keys preserved) in ${dir##*/}"
    else
      rm -f "$tmp"
      err "${dir##*/}/settings.json isn't valid JSON — refusing to edit it."
      warn "Fix the JSON, then add manually:"; info "  $snippet"
    fi
  else
    warn "${dir##*/}/settings.json exists and jq isn't installed — can't merge safely."
    warn "Add this key manually to $settings:"; info "  $snippet"
  fi
}

share_projects() {  # $1 = config dir, $2 = client: point $1/projects at the pool's shared history
  local dir="$1" shared; shared="$(pool_projects "$2")"
  mkdir -p "$shared"
  if [ -L "$dir/projects" ]; then
    ok "Session history already shared for ${dir##*/}"
    return 0
  fi
  if [ -d "$dir/projects" ]; then
    # Move existing history into the shared location (merge, never delete).
    find "$dir/projects" -mindepth 1 -maxdepth 1 -exec mv {} "$shared"/ \;
    rmdir "$dir/projects"
    add "Moved existing session history of ${dir##*/} → $shared"
  fi
  mkdir -p "$dir"
  ln -s "$shared" "$dir/projects"
  add "Linked ${dir##*/}/projects → shared pool history"
}

restore_projects() {  # $1 = primary config dir, $2 = client: give history back to the primary
  local dir="$1" shared; shared="$(pool_projects "$2")"
  [ -L "$dir/projects" ] && rm -f "$dir/projects"
  if [ -d "$shared" ] && [ ! -e "$dir/projects" ]; then
    mv "$shared" "$dir/projects"
    ok "Restored session history to $dir/projects"
  fi
}

# Tooling dirs shared across the pool the same way projects/ is: a skill,
# plugin, or agent added mid-session on ANY member is instantly visible to
# every other member — no sync needed. (MCP definitions can't join this:
# they live inside each member's .claude.json next to account state, so
# they're synced instead — see wire_sync_hook and cc-pool-sync.)
TOOLING_DIRS="skills plugins agents commands"

share_tooling() {  # $1 = config dir, $2 = client: symlink tooling dirs into the pool
  local dir="$1" client="$2" d shared entry name tmp
  for d in $TOOLING_DIRS; do
    shared="$POOLS_DIR/${client}-${d}"
    if [ -L "$dir/$d" ]; then
      ok "$d already shared for ${dir##*/}"
      continue
    fi
    mkdir -p "$shared"
    if [ -d "$dir/$d" ]; then
      # Merge existing content in (never delete pool content). Same-named
      # JSON files are jq-merged (member wins — freshest data); other
      # same-named entries keep the pool's copy (assumed duplicate).
      for entry in "$dir/$d"/* "$dir/$d"/.[!.]* "$dir/$d"/..?*; do
        [ -e "$entry" ] || continue
        name="$(basename "$entry")"
        if [ ! -e "$shared/$name" ]; then
          mv "$entry" "$shared/$name"
        else
          case "$name" in
            *.json)
              if [ -f "$entry" ] && command -v jq >/dev/null 2>&1; then
                tmp="$(mktemp)"
                if jq -s '.[0] * .[1]' "$shared/$name" "$entry" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
                  mv "$tmp" "$shared/$name"
                else rm -f "$tmp"; fi
              fi
              rm -rf "$entry" ;;
            *) rm -rf "$entry" ;;
          esac
        fi
      done
      if ! rmdir "$dir/$d" 2>/dev/null; then
        warn "${dir##*/}/$d could not be emptied — left unshared"
        continue
      fi
      add "Merged ${dir##*/}/$d into the shared pool $d"
    fi
    ln -s "$shared" "$dir/$d"
    add "Linked ${dir##*/}/$d → shared pool $d"
  done
}

restore_tooling() {  # $1 = primary config dir, $2 = client: give tooling back on disband
  local dir="$1" client="$2" d shared
  for d in $TOOLING_DIRS; do
    shared="$POOLS_DIR/${client}-${d}"
    [ -L "$dir/$d" ] && rm -f "$dir/$d"
    if [ -d "$shared" ] && [ ! -e "$dir/$d" ]; then
      mv "$shared" "$dir/$d"
      ok "Restored $d to $dir/$d"
    fi
  done
}

wire_sync_hook() {  # $1 = config dir: push MCP defs to pool siblings when a session ends
  local dir="$1" settings="$1/settings.json" sync_cmd="$SHARED_DIR/cc-pool-sync --push-mcp"
  if [ -f "$settings" ] && grep -qF "cc-pool-sync" "$settings"; then
    ok "MCP sync hook already wired in ${dir##*/}/settings.json"
    return 0
  fi
  if [ ! -f "$settings" ]; then
    mkdir -p "$dir"
    printf '{\n  "hooks": { "SessionEnd": [ { "hooks": [ { "type": "command", "command": "%s" } ] } ] }\n}\n' "$sync_cmd" > "$settings"
    add "Created settings.json with MCP sync hook in ${dir##*/}"
  elif command -v jq >/dev/null 2>&1; then
    local tmp; tmp="$(mktemp)"
    if jq --arg cmd "$sync_cmd" '.hooks.SessionEnd = ((.hooks.SessionEnd // []) + [
          {hooks: [{type: "command", command: $cmd}]}
        ])' "$settings" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$settings"
      add "Added MCP sync hook (SessionEnd) to ${dir##*/}/settings.json"
    else
      rm -f "$tmp"
      err "${dir##*/}/settings.json isn't valid JSON — refusing to edit it."
    fi
  else
    warn "${dir##*/}/settings.json exists and jq isn't installed — wire the SessionEnd hook manually:"
    info "  \"hooks\": { \"SessionEnd\": [ { \"hooks\": [ { \"type\": \"command\", \"command\": \"$sync_cmd\" } ] } ] }"
  fi
}

next_member_name() {  # $1 = client: first free <client>-N (N >= 2)
  local n=2
  while [ -d "$CLIENTS_PARENT/$1-$n" ] || grep -qxF "$CLIENTS_PARENT/$1-$n" "$(pool_file "$1")" 2>/dev/null; do
    n=$((n + 1))
  done
  printf '%s-%s' "$1" "$n"
}

logged_in() {  # $1 = config dir: 0 if this dir holds a completed login
  # Ask claude itself when we can (authoritative, keychain-aware, ~0.15s).
  if command -v claude >/dev/null 2>&1; then
    CLAUDE_CONFIG_DIR="$1" command claude auth status >/dev/null 2>&1; return
  fi
  [ -f "$1/.credentials.json" ] && return 0
  grep -qs '"oauthAccount"' "$1/.claude.json" && return 0
  return 1
}

can_login_here() {  # interactive login possible? (claude on PATH + a real tty)
  command -v claude >/dev/null 2>&1 || return 1
  { : </dev/tty; } 2>/dev/null || return 1
  return 0
}

# Account pins: <dir>/.ccb-account holds the email a dir must be logged into.
# A /login typed inside a rotated session saves to the account that is active
# at that moment, so without a pin one dir can silently drift onto another's
# subscription. cc-rotate skips, cc-member refuses, the footer flags a mismatch.
PIN_FILE=".ccb-account"
pinned_email() { cat "$1/$PIN_FILE" 2>/dev/null || true; }
account_email() {  # $1 = config dir: the logged-in email per .claude.json ("" if unknown)
  command -v jq >/dev/null 2>&1 || return 0
  jq -r '.oauthAccount.emailAddress // ""' "$1/.claude.json" 2>/dev/null || true
}
pin_mismatch() {  # $1 = config dir: 0 if pinned AND logged into a different account
  local p a; p="$(pinned_email "$1")"; a="$(account_email "$1")"
  [ -n "$p" ] && [ -n "$a" ] && [ "$p" != "$a" ]
}

org_lock() {  # $1 = config dir: once it is on its pinned account, lock its logins to that org
  # forceLoginOrgUUID makes claude itself reject a login into any other org, so
  # a /login typed inside a rotated session can no longer switch this dir onto
  # another subscription. Per-dir on purpose: cc-pool-sync never copies it.
  local dir="$1" org cur tmp
  command -v jq >/dev/null 2>&1 || return 0
  [ -n "$(pinned_email "$dir")" ] && ! pin_mismatch "$dir" || return 0
  org="$(jq -r '.oauthAccount.organizationUuid // ""' "$dir/.claude.json" 2>/dev/null)"
  [ -n "$org" ] || return 0
  cur="$(jq -r '.forceLoginOrgUUID // "" | if type=="array" then join(",") else . end' "$dir/settings.json" 2>/dev/null)"
  [ "$cur" = "$org" ] && return 0
  tmp="$(mktemp)"
  if { [ -f "$dir/settings.json" ] && jq --arg o "$org" '.forceLoginOrgUUID = $o' "$dir/settings.json" || jq -n --arg o "$org" '{forceLoginOrgUUID: $o}'; } > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    [ -f "$dir/settings.json" ] && cp "$dir/settings.json" "$dir/settings.json.ccbak"
    cat "$tmp" > "$dir/settings.json"; add "Locked ${dir##*/} logins to its org ($org) via forceLoginOrgUUID"
  else warn "could not set forceLoginOrgUUID in ${dir##*/}/settings.json"; fi
  rm -f "$tmp"
}

login_dir() {  # $1 = config dir: run claude's own login flow there
  local dir="$1" label="${1##*/}" pin; pin="$(pinned_email "$1")"
  if [ -n "$pin" ]; then
    info "Sign '$label' in as $pin (its pinned account; the login page is pre-filled)."
    info "If the browser picks another Google account, switch accounts on the OAuth page."
  elif [ -f "$dir/$POOL_MARKER" ]; then
    info "Sign '$label' into a DIFFERENT subscription than '$(cat "$dir/$POOL_MARKER")' already uses."
    info "If the browser auto-picks your usual account, switch accounts on the OAuth page."
  fi
  if can_login_here; then
    info "Starting login for $label — sign in in the browser; you'll come straight back here."
    CLAUDE_CONFIG_DIR="$dir" command claude auth login ${pin:+--email "$pin"} || true
    if pin_mismatch "$dir"; then
      err "$label logged in as $(account_email "$dir") — NOT its pinned account $pin."
      err "Rotation will skip it until fixed. Retry: claude-session --login $label"
    elif logged_in "$dir"; then
      ok "$label is logged in${pin:+ as $pin}"
      # First login sticks: cc-account-guard pins an unpinned dir to it and locks the org.
      if [ -z "$pin" ] && [ -x "$SHARED_DIR/cc-account-guard" ]; then
        SHARED_DIR="$SHARED_DIR" "$SHARED_DIR/cc-account-guard" "$dir" || true
      else org_lock "$dir"; fi
    else warn "$label still has no credentials — retry with: claude-session --login $label"; fi
  else
    warn "Can't launch claude interactively here (needs claude on PATH and a terminal)."
    info "From a terminal: claude-session --login $label"
    info "  (equivalent: CLAUDE_CONFIG_DIR=$dir command claude auth login)"
  fi
}

print_pool() {  # $1 = client: list members, order, login state
  local pf; pf="$(pool_file "$1")" || return 1
  [ -f "$pf" ] || return 1
  local dir first=1 tag state
  while IFS= read -r dir; do
    case "$dir" in ''|\#*) continue ;; esac
    [ "$first" -eq 1 ] && tag="(primary)" || tag=""
    first=0
    if [ ! -d "$dir" ]; then
      printf "  ${RED}✗${RESET} %-16s ${DIM}%s${RESET} MISSING ON DISK\n" "$(basename "$dir")" "$dir"
      continue
    fi
    if logged_in "$dir"; then state="${GREEN}logged in${RESET}"; else state="${RED}NO CREDENTIALS${RESET}"; fi
    printf "  ${GREEN}●${RESET} %-16s ${DIM}%-40s${RESET} %b %s\n" "$(basename "$dir")" "$dir" "$state" "$tag"
    if ! logged_in "$dir"; then
      if [ -f "$dir/$POOL_MARKER" ]; then
        info "    log in with: $(fn_label "$dir")   (logs in, then starts a session)"
      else
        info "    log in with: claude-session --login $(basename "$dir")"
      fi
    fi
  done < "$pf"
}

finish() {  # tell the user how/whether the shell got reloaded
  if [ "${CLAUDE_SESSION_WRAPPED:-0}" = "1" ]; then
    printf "\n${GREEN}Done.${RESET} Shell reloaded automatically.\n"
  else
    printf "\n${GREEN}Done.${RESET} One-time step: ${BOLD}source %s${RESET} (or open a new terminal).\n" "$RC_FILE"
    info "After that, 'claude-session' is available everywhere and reloads your shell for you."
  fi
}

# --- commands --------------------------------------------------------------
cmd_create() {
  [ "${#NAMES[@]}" -gt 0 ] || die "Usage: claude-session --create <name> [name...]"
  hdr "Creating clients: ${NAMES[*]}"
  install_skill
  install_cli
  install_rotate
  local setup; setup="$(find_setup)" || die "setup.sh not found"
  local n
  for n in "${NAMES[@]}"; do
    [ -n "$n" ] || continue
    printf "\n${BOLD}• %s${RESET}\n" "$n"
    env -u CLAUDE_CONFIG_DIR bash "$setup" --client "$n" --clients-parent "$CLIENTS_PARENT" --shared-dir "$SHARED_DIR"
    ensure_plugin "$CLIENTS_PARENT/$n"        # each account loads plugins and skills from its own dir
    install_skill_into "$CLIENTS_PARENT/$n"
  done
  hdr "Shell launchers"
  rebuild_launchers
  finish
}

cmd_update() {  # pull the latest version and refresh every client from it
  # Phase 1 (the installed copy): fast-forward our own clone, then hand over to
  # the new version so the refresh below always runs the latest code.
  if [ "${CCB_UPDATE_REEXEC:-0}" != "1" ]; then
    command -v git >/dev/null 2>&1 || die "--update needs git"
    local url before="" after lock="$SHARED_DIR/.update.lock" rc
    url="$(cat "$SOURCE_FILE" 2>/dev/null || true)"
    [ -n "$url" ] || url="$(git -C "$SCRIPT_DIR" remote get-url origin 2>/dev/null || true)"
    [ -n "$url" ] || url="${CCB_SOURCE_URL:-}"   # set by the plugin's hook (its copy has no .git)
    [ -n "$url" ] || die "don't know where to update from — run it once from a git checkout: <repo>/claude-session --update"
    mkdir -p "$SHARED_DIR"
    if ! mkdir "$lock" 2>/dev/null; then
      [ "$AUTO" -eq 1 ] && exit 0
      die "another update is running (if not, remove $lock)"
    fi
    trap 'rmdir "$lock" 2>/dev/null || true' EXIT
    : > "$UPDATE_STAMP"
    if [ -d "$UPDATE_SRC/.git" ]; then
      before="$(git -C "$UPDATE_SRC" rev-parse HEAD)"
      git -C "$UPDATE_SRC" pull -q --ff-only || die "could not fast-forward $UPDATE_SRC"
    else
      git clone -q "$url" "$UPDATE_SRC" || die "could not clone $url"
    fi
    printf '%s\n' "$url" > "$SOURCE_FILE"
    after="$(git -C "$UPDATE_SRC" rev-parse HEAD)"
    [ "$AUTO" -eq 1 ] && [ "$before" = "$after" ] && exit 0   # nothing new
    hdr "Updating claude-session to $(git -C "$UPDATE_SRC" log -1 --format='%h %s')"
    set +e
    CCB_UPDATE_REEXEC=1 bash "$UPDATE_SRC/claude-session" --update $([ "$AUTO" -eq 1 ] && echo --auto)
    rc=$?; set -e
    exit "$rc"
  fi
  # Phase 2 (the new version): refresh exactly what --create would, for every client.
  install_cli
  install_rotate
  local setup d; setup="$(find_setup)" || die "setup.sh not found"
  discover_dirs
  for d in ${CC_DIRS[@]+"${CC_DIRS[@]}"}; do
    printf "\n${BOLD}• %s${RESET}\n" "${d##*/}"
    env -u CLAUDE_CONFIG_DIR bash "$setup" --client "${d##*/}" --clients-parent "$CLIENTS_PARENT" --shared-dir "$SHARED_DIR"
    ensure_plugin "$d"
    install_skill_into "$d"
  done
  discover_members   # pool members load plugins from their own settings too
  for d in ${CC_MEMBERS[@]+"${CC_MEMBERS[@]}"}; do
    printf "\n${BOLD}• %s${RESET} (pool member)\n" "${d##*/}"
    ensure_plugin "$d"
    install_skill_into "$d"
  done
  hdr "Shell launchers"
  rebuild_launchers
  [ "$AUTO" -eq 1 ] && { printf '%s updated\n' "$(date '+%F %T')"; return 0; }
  finish
}

cmd_delete() {
  [ "${#NAMES[@]}" -gt 0 ] || die "Usage: claude-session --delete <name> [name...]"
  hdr "Deleting clients: ${NAMES[*]}"
  local n dir pf d
  for n in "${NAMES[@]}"; do
    [ -n "$n" ] || continue
    dir="$CLIENTS_PARENT/$n"
    if [ -f "$dir/$POOL_MARKER" ]; then
      warn "'$n' is a rotation pool member — remove it with: claude-session --pool-remove $n"
      continue
    fi
    pf="$(pool_file "$n")"
    if [ -f "$pf" ]; then
      warn "'$n' has a rotation pool: this deletes the primary, EVERY pool account,"
      warn "and the pool's shared session history."
      if confirm "Delete client '$n' and its whole pool?"; then
        while IFS= read -r d; do
          case "$d" in ''|\#*) continue ;; esac
          [ "$d" = "$dir" ] && continue
          [ -d "$d" ] && { rm -rf "$d"; ok "Removed pool member ${d##*/}"; }
        done < "$pf"
        rm -rf "$(pool_projects "$n")"; rm -f "$pf"
        rm -rf "$dir"; ok "Removed $dir (pool + shared history included)"
      else
        warn "Skipped $n"
      fi
      continue
    fi
    if [ -d "$dir" ]; then
      if confirm "Delete $dir? (removes that account's local login + history)"; then
        rm -rf "$dir"; ok "Removed $dir"
      else
        warn "Skipped $n"
      fi
    else
      warn "No client dir for '$n' at $dir — skipping"
    fi
  done
  hdr "Shell launchers"
  rebuild_launchers
  finish
}

cmd_list() {
  discover_dirs
  hdr "Configured clients"
  if [ "${#CC_DIRS[@]}" -eq 0 ]; then
    info "none — create one with: claude-session --create <name>"
  else
    local d
    for d in "${CC_DIRS[@]}"; do printf "  ${GREEN}●${RESET} %-16s ${DIM}%s${RESET}\n" "$(basename "$d")" "$d"; done
  fi
  discover_members
  if [ "${#CC_MEMBERS[@]}" -gt 0 ]; then
    hdr "Pool member accounts (direct launch, no rotation)"
    for d in "${CC_MEMBERS[@]}"; do printf "  ${GREEN}●${RESET} %-16s ${DIM}%s${RESET}\n" "$(fn_label "$d")" "$d"; done
  fi
}

cmd_pool_add() {
  [ "${#NAMES[@]}" -eq 1 ] || die "Usage: claude-session --pool-add <client>"
  local client="${NAMES[0]}" primary_dir pf setup
  primary_dir="$CLIENTS_PARENT/$client"
  [ -f "$primary_dir/$POOL_MARKER" ] && die "'$client' is itself a pool member (of $(cat "$primary_dir/$POOL_MARKER")). Pool-add the primary client instead."
  { [ -f "$primary_dir/CLAUDE.md" ] && grep -qF "$SENTINEL_BEGIN" "$primary_dir/CLAUDE.md" 2>/dev/null; } \
    || die "No bootstrapped client '$client' at $primary_dir — create it first: claude-session --create $client"

  hdr "Adding a rotation account to '$client'"
  install_skill
  install_cli
  install_rotate
  setup="$(find_setup)" || die "setup.sh not found"

  # First --pool-add for this client: create the pool around the primary.
  mkdir -p "$POOLS_DIR"
  pf="$(pool_file "$client")"
  if [ ! -f "$pf" ]; then
    printf '%s\n' "$primary_dir" > "$pf"
    add "Created pool: $pf (primary: $client)"
  else
    ok "Pool exists: $pf"
  fi
  share_projects "$primary_dir" "$client"
  share_tooling "$primary_dir" "$client"
  wire_hook "$primary_dir"
  wire_sync_hook "$primary_dir"

  # New member: next free <client>-N, bootstrapped like any config dir.
  local member member_dir
  member="$(next_member_name "$client")"
  member_dir="$CLIENTS_PARENT/$member"
  printf "\n${BOLD}• %s${RESET} (new pool member)\n" "$member"
  env -u CLAUDE_CONFIG_DIR bash "$setup" --client "$member" --clients-parent "$CLIENTS_PARENT" --shared-dir "$SHARED_DIR"
  printf '%s\n' "$client" > "$member_dir/$POOL_MARKER"
  wire_hook "$member_dir"
  wire_sync_hook "$member_dir"
  share_projects "$member_dir" "$client"
  share_tooling "$member_dir" "$client"
  # MCP parity: the new member inherits the primary's server definitions
  # (skills/plugins/agents are already shared via the symlinks above).
  if [ -x "$SHARED_DIR/cc-pool-sync" ]; then
    "$SHARED_DIR/cc-pool-sync" "$primary_dir" "$member_dir" || warn "MCP sync failed — run by hand: $SHARED_DIR/cc-pool-sync $primary_dir $member_dir"
  fi
  grep -qxF "$member_dir" "$pf" || printf '%s\n' "$member_dir" >> "$pf"
  ok "Added $member to the pool (rotation order = pool file order)"

  hdr "Shell launchers"
  rebuild_launchers

  # Log the new account in. The login IS the connection: signing in inside
  # this dir binds the new subscription to it, isolated from every other dir.
  hdr "Log in the new account"
  if can_login_here && confirm "Launch claude under $member now to log in?"; then
    login_dir "$member_dir"
  else
    warn "Log in later by just running: $(fn_label "$member_dir")"
  fi

  hdr "Pool status for '$client'"
  print_pool "$client"
  info "cc-$client now rotates automatically: it starts on the primary and switches"
  info "to the next logged-in account when a rate limit is hit, resuming the session."
  finish
}

cmd_login() {
  [ "${#NAMES[@]}" -gt 0 ] || die "Usage: claude-session --login <client-or-member> [name...]"
  local n dir pf d queued targets=()
  for n in "${NAMES[@]}"; do
    [ -n "$n" ] || continue
    dir="$CLIENTS_PARENT/$n"
    pf="$(pool_file "$n")"
    if [ -f "$pf" ]; then
      # Pooled client: log in every member that still needs credentials.
      queued=0
      while IFS= read -r d; do
        case "$d" in ''|\#*) continue ;; esac
        [ -d "$d" ] || continue
        if ! logged_in "$d" || pin_mismatch "$d"; then targets+=("$d"); queued=1; fi
      done < "$pf"
      [ "$queued" -eq 0 ] && ok "All accounts in '$n's pool are logged in (and on their pinned accounts)"
    elif [ -d "$dir" ]; then
      targets+=("$dir")
    else
      warn "No client or pool member '$n' at $dir — skipping"
    fi
  done
  [ "${#targets[@]}" -gt 0 ] || return 0

  hdr "Login"
  for d in "${targets[@]}"; do
    if logged_in "$d"; then
      confirm "'${d##*/}' is already logged in — log in again (e.g. to switch its account)?" \
        || { warn "Skipped ${d##*/}"; continue; }
    fi
    login_dir "$d"
  done
}

cmd_pool_list() {
  [ "${#NAMES[@]}" -eq 1 ] || die "Usage: claude-session --pool-list <client>"
  local client="${NAMES[0]}"
  hdr "Rotation pool for '$client'"
  if [ -f "$(pool_file "$client")" ]; then
    print_pool "$client"
  else
    info "no pool — cc-$client is single-account. Create one with: claude-session --pool-add $client"
  fi
}

cmd_usage() {
  [ "${#NAMES[@]}" -eq 1 ] || die "Usage: claude-session --usage <client>"
  local client="${NAMES[0]}" pf dir label who uuid at f fr sv svr now age seen="" dup
  pf="$(pool_file "$client")"
  [ -f "$pf" ] || die "no pool for '$client' — usage is shown in the cc-$client footer"
  now="$(date +%s)"
  hdr "Usage for pool '$client'  ${DIM}(last reading from each account's own sessions)${RESET}"
  while IFS= read -r dir; do
    case "$dir" in ''|\#*) continue ;; esac
    label="$(basename "$dir")"; who="?"; uuid=""
    if command -v jq >/dev/null 2>&1 && [ -f "$dir/.claude.json" ]; then
      who="$(jq -r '.oauthAccount.emailAddress // "not logged in"' "$dir/.claude.json" 2>/dev/null)"
      uuid="$(jq -r '.oauthAccount.accountUuid // ""' "$dir/.claude.json" 2>/dev/null)"
    fi
    dup=""
    if [ -n "$uuid" ]; then
      case "$seen" in *"|$uuid="*) dup="${seen#*|$uuid=}"; dup="${dup%%|*}" ;; esac
      seen="${seen}|$uuid=$label|"
    fi
    printf "  ${GREEN}●${RESET} %-14s %-34s" "$label" "$who"
    if IFS=$'\t' read -r at f fr sv svr 2>/dev/null < "$SHARED_DIR/usage/$label.tsv"; then
      [ "${fr:-0}" -gt 0 ] && [ "$fr" -le "$now" ] && f=0
      [ "${svr:-0}" -gt 0 ] && [ "$svr" -le "$now" ] && sv=0
      age=$(( (now - at) / 60 ))
      printf " 5h %3s%%" "$f"; [ "${fr:-0}" -gt "$now" ] && printf " ${DIM}→%s${RESET}" "$(date -r "$fr" +%H:%M)"
      printf "  7d %3s%%" "$sv"; [ "${svr:-0}" -gt "$now" ] && printf " ${DIM}→%s${RESET}" "$(date -r "$svr" '+%a %H:%M')"
      printf "  ${DIM}(%sm ago)${RESET}" "$age"
    else
      printf " ${DIM}no reading yet — start a session on it (cc-%s)${RESET}" "$label"
    fi
    printf '\n'
    pin_mismatch "$dir" && err "    $label is pinned to $(pinned_email "$dir") but logged in as $who — rotation skips it. Fix: claude-session --login $label"
    [ -n "$dup" ] && warn "    $label is logged into the SAME account as $dup — rotating between them gains nothing. Fix: claude-session --login $label"
  done < "$pf"
}

cmd_pin() {
  [ "${#NAMES[@]}" -eq 1 ] && [ -n "$PIN_EMAIL" ] || die "Usage: claude-session --pin <client-or-member> <email>   (or --pin <name> --clear)"
  local dir="$CLIENTS_PARENT/${NAMES[0]}"
  [ -d "$dir" ] || die "no client or pool member '${NAMES[0]}' at $dir"
  if [ "$PIN_EMAIL" = "--clear" ]; then
    rm -f "$dir/$PIN_FILE"; ok "Unpinned ${NAMES[0]}"
    if command -v jq >/dev/null 2>&1 && jq -e 'has("forceLoginOrgUUID")' "$dir/settings.json" >/dev/null 2>&1; then
      local tmp; tmp="$(mktemp)"; jq 'del(.forceLoginOrgUUID)' "$dir/settings.json" > "$tmp" && cat "$tmp" > "$dir/settings.json"; rm -f "$tmp"
      ok "Removed its forceLoginOrgUUID login lock"
    fi
    return
  fi
  printf '%s\n' "$PIN_EMAIL" > "$dir/$PIN_FILE"
  ok "Pinned ${NAMES[0]} → $PIN_EMAIL"
  if pin_mismatch "$dir"; then warn "It is currently logged in as $(account_email "$dir"). Fix: claude-session --login ${NAMES[0]}"
  else org_lock "$dir"; fi
}

cmd_rotate() {
  [ "${#NAMES[@]}" -ge 1 ] && [ "${#NAMES[@]}" -le 2 ] || die "Usage: claude-session --rotate <client> [member]"
  [ -f "$(pool_file "${NAMES[0]}")" ] || die "no pool for '${NAMES[0]}'"
  [ -x "$SHARED_DIR/cc-rotate-now" ] || install_rotate
  "$SHARED_DIR/cc-rotate-now" --client "${NAMES[0]}" ${NAMES[1]+"${NAMES[1]}"}
}

cmd_pool_remove() {
  [ "${#NAMES[@]}" -gt 0 ] || die "Usage: claude-session --pool-remove <member> [member...]"
  local m dir client pf remaining
  for m in "${NAMES[@]}"; do
    [ -n "$m" ] || continue
    dir="$CLIENTS_PARENT/$m"
    if [ ! -f "$dir/$POOL_MARKER" ]; then
      if [ -f "$(pool_file "$m")" ]; then
        err "'$m' is a pool PRIMARY, not a member. Remove its members one by one"
        err "(the pool disbands when the last member goes), or delete the whole"
        die "client with: claude-session --delete $m"
      fi
      warn "'$m' is not a pool member — skipping"
      continue
    fi
    client="$(cat "$dir/$POOL_MARKER")"
    pf="$(pool_file "$client")"
    if confirm "Remove $m from '$client's pool and DELETE $dir? (removes that account's local login)"; then
      if [ -f "$pf" ]; then
        local tmp; tmp="$(mktemp)"
        grep -vxF "$dir" "$pf" > "$tmp" || true
        mv "$tmp" "$pf"
      fi
      rm -rf "$dir"
      ok "Removed $m"
      remaining="$(grep -cv '^[[:space:]]*$' "$pf" 2>/dev/null || echo 0)"
      if [ "$remaining" -le 1 ]; then
        restore_projects "$CLIENTS_PARENT/$client" "$client"
        restore_tooling "$CLIENTS_PARENT/$client" "$client"
        rm -f "$pf"
        ok "Pool disbanded — cc-$client is single-account again"
        info "(the rate-limit hook stays in settings.json; it's inert without cc-rotate)"
      fi
    else
      warn "Skipped $m"
    fi
  done
  hdr "Shell launchers"
  rebuild_launchers
  finish
}

cmd_revert() {
  hdr "Revert"
  discover_dirs
  if [ "$FORCE" -eq 1 ]; then
    warn "FORCE: this will also DELETE every client account dir and its logins/history."
  else
    info "Removing tooling only — client account dirs are kept (use --force to delete them too)."
  fi
  confirm "Remove launchers, the global command, and $SHARED_DIR?" || { info "Aborted. Nothing changed."; exit 0; }

  apply_block "" || true
  ok "Removed launcher block ($RC_FILE) — bare 'claude' restored (backup: ${RC_FILE}.ccbak)"

  # Rotation pools live inside SHARED_DIR (pool files + SHARED session history),
  # so hand each pool's history back to its primary dir before deleting it.
  if [ -d "$POOLS_DIR" ]; then
    local pf client primary d had_pools=0
    for pf in "$POOLS_DIR"/*.pool; do
      [ -f "$pf" ] || continue
      had_pools=1
      client="$(basename "$pf" .pool)"
      primary="$(grep -Em1 -v '^[[:space:]]*(#|$)' "$pf" || true)"
      while IFS= read -r d; do
        case "$d" in ''|\#*) continue ;; esac
        [ "$d" = "$primary" ] && continue
        if [ "$FORCE" -eq 1 ]; then
          [ -d "$d" ] && { rm -rf "$d"; ok "Removed pool member (${d##*/})"; }
        else
          if [ -L "$d/projects" ]; then rm -f "$d/projects"; mkdir -p "$d/projects"; fi
          local td
          for td in $TOOLING_DIRS; do
            [ -L "$d/$td" ] && { rm -f "$d/$td"; mkdir -p "$d/$td"; }
          done
        fi
      done < "$pf"
      [ -n "$primary" ] && [ -d "$primary" ] && restore_projects "$primary" "$client"
      [ -n "$primary" ] && [ -d "$primary" ] && restore_tooling "$primary" "$client"
    done
    if [ "$FORCE" -eq 0 ] && [ "$had_pools" -eq 1 ]; then
      warn "Kept pool member dirs (they hold real logins); their shared history went"
      warn "back to each primary. Remove leftovers by hand if unwanted."
    fi
  fi

  [ -d "$DEST_SKILL" ] && { rm -rf "$DEST_SKILL"; ok "Removed installed skill ($DEST_SKILL)"; }
  # Removing SHARED_DIR also removes the global claude-session command living inside it.
  [ -d "$SHARED_DIR" ] && { rm -rf "$SHARED_DIR"; ok "Removed shared dir ($SHARED_DIR)"; }

  if [ "$FORCE" -eq 1 ]; then
    local d
    for d in "${CC_DIRS[@]:-}"; do
      [ -n "$d" ] || continue
      rm -rf "$d"; ok "Removed client dir ($d)"
    done
  elif [ "${#CC_DIRS[@]}" -gt 0 ]; then
    warn "Kept ${#CC_DIRS[@]} client dir(s). They still hold their accounts, but their"
    warn "CLAUDE.md import + statusline now point at the removed shared files. Remove with:"
    local d
    for d in "${CC_DIRS[@]}"; do info "rm -rf $d"; done
  fi
  finish
}

case "$MODE" in
  create) cmd_create ;;
  delete) cmd_delete ;;
  list)   cmd_list ;;
  pool-add)    cmd_pool_add ;;
  pool-list)   cmd_pool_list ;;
  pool-remove) cmd_pool_remove ;;
  login)       cmd_login ;;
  usage)       cmd_usage ;;
  rotate)      cmd_rotate ;;
  pin)         cmd_pin ;;
  revert) cmd_revert ;;
  update) cmd_update ;;
esac
