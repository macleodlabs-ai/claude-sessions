{
  "description": "sessions: keep claude-session (shared scripts, footer, launchers, every client) up to date",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/claude-config-bootstrap/scripts/plugin-session-start"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
